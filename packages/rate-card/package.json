{
  "name": "@modelschemas/rate-card",
  "version": "0.2.0",
  "description": "Model pricing as data: a closed-vocabulary JSONLogic rate-card schema, a refuse-not-coerce evaluator with no dependencies, and listing compilers (OpenRouter).",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./evaluator": "./src/evaluator.ts",
    "./schema": "./src/rate-card.schema.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "license": "MIT",
  "homepage": "https://modelschemas.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelschemas/modelschemas.git",
    "directory": "packages/rate-card"
  },
  "bugs": "https://github.com/modelschemas/modelschemas/issues",
  "keywords": [
    "ai",
    "pricing",
    "rate-card",
    "jsonlogic",
    "openrouter"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./evaluator": {
        "types": "./dist/evaluator.d.ts",
        "default": "./dist/evaluator.js"
      },
      "./schema": {
        "types": "./dist/rate-card.schema.d.ts",
        "default": "./dist/rate-card.schema.js"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
