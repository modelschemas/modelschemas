{
  "name": "modelschemas",
  "version": "0.2.2",
  "description": "CLI for the modelschemas live AI model schema service.",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "modelschemas": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelschemas/client": "workspace:*",
    "@modelschemas/codegen": "workspace:*",
    "jose": "^6.2.3"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "modelschemas": "./dist/index.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT",
  "homepage": "https://modelschemas.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelschemas/modelschemas.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/modelschemas/modelschemas/issues",
  "keywords": [
    "ai",
    "json-schema",
    "openapi",
    "llm",
    "model",
    "schemas",
    "cli"
  ],
  "engines": {
    "node": ">=22.18.0"
  }
}
