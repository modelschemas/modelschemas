{
  "name": "@modelschemas/vite",
  "version": "0.2.0",
  "description": "Vite plugin for modelschemas: pull selected JSON Schemas + generated TypeScript at dev time, verify offline at build time.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ../../scripts/rewrite-dist-imports.ts dist"
  },
  "license": "MIT",
  "homepage": "https://modelschemas.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelschemas/modelschemas.git",
    "directory": "packages/vite"
  },
  "bugs": "https://github.com/modelschemas/modelschemas/issues",
  "keywords": [
    "vite-plugin",
    "ai",
    "json-schema",
    "codegen",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@modelschemas/codegen": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  }
}
