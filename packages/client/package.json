{
  "name": "@modelschemas/client",
  "version": "0.2.2",
  "description": "Typed fetch client for the modelschemas live AI model schema service.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "license": "MIT",
  "homepage": "https://modelschemas.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelschemas/modelschemas.git",
    "directory": "packages/client"
  },
  "bugs": "https://github.com/modelschemas/modelschemas/issues",
  "keywords": [
    "ai",
    "json-schema",
    "openapi",
    "llm",
    "model",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "sideEffects": false
}
