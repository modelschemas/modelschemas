{
  "name": "@modelschemas/codegen",
  "version": "0.2.0",
  "description": "Pull core for modelschemas build-time schema/type generation: selection grammar, conditional fetch, lockfile manifest, file writer.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ../../scripts/rewrite-dist-imports.ts dist"
  },
  "license": "MIT",
  "homepage": "https://modelschemas.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelschemas/modelschemas.git",
    "directory": "packages/codegen"
  },
  "bugs": "https://github.com/modelschemas/modelschemas/issues",
  "keywords": [
    "ai",
    "json-schema",
    "codegen",
    "typescript",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  }
}
