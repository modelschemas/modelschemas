                  "minimum": 0,
                  "x-order": 3,
                  "description": "The maximum number of tokens the model should generate as output."
                },
                "min_tokens": {
                  "type": "integer",
                  "title": "Min Tokens",
                  "default": 0,
                  "x-order": 2,
                  "description": "The minimum number of tokens the model should generate as output."
                },
                "temperature": {
                  "type": "number",
                  "title": "Temperature",
                  "default": 0.6,
                  "x-order": 4,
