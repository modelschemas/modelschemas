{
  "name": "modelschemas",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run db:migrate && vite dev --port 3100",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/schema-studio && tsc --noEmit -p examples/image-dimensions && tsc --noEmit -p examples/video-composer",
    "prepare": "lefthook install",
    "format": "oxfmt && oxlint --type-aware --fix",
    "check": "oxfmt --check",
    "deploy": "bun run build && bun run deploy:ci",
    "deploy:ci": "wrangler d1 migrations apply modelschemas --remote && wrangler deploy",
    "seed": "bun scripts/seed.ts",
    "secrets:check": "bun scripts/push-secrets.ts",
    "secrets:push": "bun scripts/push-secrets.ts --push",
    "secrets:pull": "bun scripts/pull-secrets.ts --write",
    "secrets:build": "bun scripts/build-with-secrets.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "openapi:emit": "bun scripts/emit-openapi.ts",
    "generate:client": "bun run openapi:emit && cd packages/client && bunx openapi-ts",
    "check:client": "bun run generate:client && git diff --exit-code openapi.json packages/client",
    "types": "wrangler types --include-runtime=false",
    "npm:pack": "bun scripts/npm-pack.ts",
    "gap:report": "bun scripts/gap-report.ts",
    "compare:models-dev": "bun scripts/compare-models-dev.ts"
  },
  "dependencies": {
    "@better-auth/agent-auth": "^0.6.2",
    "@better-auth/api-key": "^1.7.11",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@modelschemas/rate-card": "workspace:*",
    "@posthog/react": "^1.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "latest",
    "@tanstack/ai-anthropic": "latest",
    "@tanstack/ai-client": "latest",
    "@tanstack/ai-gemini": "latest",
    "@tanstack/ai-ollama": "latest",
    "@tanstack/ai-openai": "latest",
    "@tanstack/ai-react": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-store": "latest",
    "@tanstack/router-plugin": "^1.168.47",
    "@tanstack/store": "latest",
    "better-auth": "^1.7.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.577.0",
    "posthog-js": "^1.438.12",
    "posthog-node": "^5.56.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20260611.1",
    "@hey-api/openapi-ts": "0.0.0-next-20260930190945",
    "@modelschemas/client": "workspace:*",
    "@modelschemas/codegen": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.45",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.5",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
